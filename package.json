{
  "name": "xpig-root",
  "version": "1.0.0",
  "description": "Root package to easily run frontend and backend",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "backend": "venv\\Scripts\\python run.py"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  }
}
